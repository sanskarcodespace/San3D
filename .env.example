# Copy to .env.local. The initial application does not require any credentials.
# NEXT_PUBLIC_* values are exposed to the browser. Never use them for secrets.

# Future Supabase integration: project URL and browser-safe publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Future Razorpay integration: server-side order creation and verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
