# Copy to .env.local only when that file does not already exist.
# NEXT_PUBLIC_* values are exposed to the browser. Never use them for secrets.

# Supabase project URL and browser-safe publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reserved, unused by catalogue/admin. Leave blank; bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Future Razorpay integration: server-side order creation and verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live Supabase is the default. For local demo development only, set to demo.
SAN3D_CATALOGUE_SOURCE=supabase
# Explicit opt-in for a local production-mode demo test server (never hosting).
SAN3D_ALLOW_DEMO_PREVIEW=false
# Leave true on HTTPS hosting; set false only for a localhost production preview.
SUPABASE_COOKIE_SECURE=true
